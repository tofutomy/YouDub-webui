# Copy values into .env for application runtime.
# Keep env.txt for local editing if you do not want to open .env directly.
WORKFOLDER=./workfolder
MODEL_CACHE_DIR=./data/modelscope
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
DEVICE=cuda
DEMUCS_DEVICE=
WHISPER_DEVICE=
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_UPLOAD_MAX_BYTES=4294967296
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATE_CONCURRENCY=50
YTDLP_PROXY_PORT=
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad
# Optional remote FunASR/vLLM service. When set, funasr:* ASR models are sent
# over HTTP instead of importing local funasr/vllm in the YouDub backend.
# Use /asr with FunASR serve_vllm.py, or /v1/audio/transcriptions with the
# OpenAI-compatible funasr-server endpoint.
# FUNASR_REMOTE_BASE_URL=http://127.0.0.1:8899
# FUNASR_REMOTE_ENDPOINT=/asr
# auto converts Windows paths like G:\FFOutput\a.wav to /mnt/g/FFOutput/a.wav
# for same-machine WSL service reads. Set off to use multipart upload.
# FUNASR_REMOTE_PATH_MODE=auto
# FUNASR_REMOTE_TIMEOUT=900
# FUNASR_REMOTE_SPK=false
# FUNASR_REMOTE_MODEL=fun-asr-nano
# Auto-start the same-machine WSL vLLM service when remote Nano is selected and
# the service is not already listening. Auto-stop only closes services started
# by the current ASR run.
# FUNASR_REMOTE_AUTOSTART=false
# FUNASR_REMOTE_AUTOSTOP=true
# FUNASR_REMOTE_START_TIMEOUT=300
# FUNASR_REMOTE_START_COMMAND=
# FUNASR_REMOTE_STOP_COMMAND=
# FunASR vLLM engine. Required for LLM-based models (Fun-ASR-Nano, GLM-ASR-Nano, LLMASR).
# auto: enable when the model needs vllm and the package is installed
# on:  force on (raises if vllm is not installed)
# off: force off (LLM-based models will raise NotImplementedError)
# FUNASR_USE_VLLM=auto
VOXCPM_MODEL=OpenBMB/VoxCPM2
VOXCPM_MODEL_DIR=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
