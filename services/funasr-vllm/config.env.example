FUNASR_SOURCE_DIR=$HOME/ai/upstream/FunASR
VENV_DIR=$HOME/ai/funasr-service/.venv
# Python used only to bootstrap uv when uv is not already installed.
PYTHON_BIN=
# Python version for the actual FunASR/vLLM runtime. vLLM supports Python 3.10-3.13.
PYTHON_VERSION=3.12
# vLLM's current default CUDA binary line is 12.9.
VLLM_CUDA_VERSION=129
# Optional exact vLLM release version. Leave empty for latest release.
VLLM_VERSION=
# Prefer vLLM prebuilt kernels/wheels and avoid requiring nvcc in WSL.
VLLM_USE_PRECOMPILED=1
# Optional CUDA Toolkit root. Needed only if vLLM/FunASR tries to compile CUDA code.
# For torch cu129, prefer CUDA Toolkit 12.9.
CUDA_HOME=
# Optional host compiler for nvcc. CUDA 12.9 supports GCC up to 14.
CC=
CXX=
CUDAHOSTCXX=
CUDA_VISIBLE_DEVICES=0
FUNASR_SERVICE_PORT=8899
FUNASR_SERVICE_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
# vLLM reserves this fraction of VRAM. Use 0.35-0.5 on a shared desktop GPU.
FUNASR_GPU_MEMORY_UTILIZATION=0.45
FUNASR_MAX_MODEL_LEN=4096
# Colon-separated WSL paths that /asr is allowed to read in path mode.
FUNASR_ALLOWED_AUDIO_ROOTS=/mnt/g/FFOutput:/mnt/f/AI/YouDub-webui/workfolder
